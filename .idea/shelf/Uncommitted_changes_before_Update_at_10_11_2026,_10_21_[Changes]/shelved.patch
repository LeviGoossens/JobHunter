<+>/* Reuse the CV's colors, typography, header, contact details and print button. */\n.motivation-page {\n  min-height: 297mm;\n}\n\n.cv-body.motivation-body {\n  grid-template-columns: 210px minmax(0, 1fr);\n  gap: 30px;\n}\n\n.personal-address,\n.recipient-address {\n  font-style: normal;\n}\n\n.page.motivation-page .letter-content {\n  display: block;\n  min-width: 0;\n  font-size: 13px;\n  line-height: 1.65;\n  color: #3a3a3a;\n}\n\n.recipient-address {\n  margin-bottom: 22px;\n}\n\n.recipient-address strong {\n  color: var(--text-heading);\n}\n\n.letter-date {\n  margin-bottom: 22px;\n  color: var(--text-muted);\n}\n\n.letter-subject {\n  display: block;\n  font-size: 15px;\n  line-height: 1.5;\n  padding-bottom: 10px;\n  margin-bottom: 22px;\n}\n\n.letter-text > p {\n  margin-bottom: 18px;\n}\n\n.letter-signature {\n  margin-top: 24px;\n}\n\n.signature-name {\n  font-family: 'Montserrat', sans-serif;\n  font-weight: 700;\n  color: var(--text-heading);\n  margin-top: 18px;\n}\n\n@media screen and (max-width: 700px) {\n  .motivation-page {\n    min-height: 0;\n  }\n\n  .cv-body.motivation-body {\n    grid-template-columns: 1fr;\n    gap: 30px;\n  }\n}\n\n@media print {\n  .motivation-page {\n    -webkit-print-color-adjust: exact;\n    print-color-adjust: exact;\n    page-break-after: auto;\n    break-after: auto;\n  }\n\n  /* Override the CV's compact first-page rules for a spacious letter layout. */\n  .page.motivation-page .cv-body {\n    grid-template-columns: 210px minmax(0, 1fr);\n    gap: 28px;\n    padding: 26px 35px 30px;\n  }\n\n  .page.motivation-page .sidebar {\n    gap: 24px;\n  }\n\n  .page.motivation-page .contact-list {\n    gap: 12px;\n  }\n\n  .letter-text > p,\n  .letter-signature {\n    break-inside: avoid;\n  }\n}\n
